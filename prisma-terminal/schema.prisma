generator client {
  provider   = "prisma-client"
  output     = "../scripts/terminal/generated/db"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("TERMINAL_DATABASE_URL")
}

model DataSource {
  id          String   @id @default(cuid())
  provider    String   @unique
  displayName String
  baseUrl     String
  version     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots       MarketSnapshot[]
  metricSnapshots MetricSnapshot[]
  collectionLogs  CollectionLog[]
}

model MarketSnapshot {
  id            String   @id @default(cuid())
  sourceId      String
  asset         String

  priceUsd      Decimal     @db.Decimal(38, 18)
  change24hPct  Decimal?    @db.Decimal(18, 8)
  volume24hUsd  Decimal?    @db.Decimal(38, 2)
  marketCapUsd  Decimal?    @db.Decimal(38, 2)

  sourceTs      DateTime
  collectedAt   DateTime

  dailyClose    DailyClose?   @relation("SnapshotToDailyClose")
  source        DataSource    @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, asset, collectedAt])
  @@index([asset, collectedAt])
  @@index([asset, sourceTs])
}

model MetricSnapshot {
  id            String   @id @default(cuid())
  sourceId      String
  scope         String
  metric        String

  value         Decimal     @db.Decimal(38, 8)
  unit          String

  bucketTs      DateTime?
  collectedAt   DateTime
  sourceTs      DateTime?

  source        DataSource    @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, scope, metric, collectedAt])
  @@index([scope, metric, bucketTs])
  @@index([scope, metric, collectedAt])
}

model DailyClose {
  id                String   @id @default(cuid())
  asset             String
  date              DateTime     @db.Date
  closeUsd          Decimal     @db.Decimal(38, 18)

  sourceSnapshotId  String   @unique
  sourceSnapshot    MarketSnapshot @relation("SnapshotToDailyClose", fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  calcMethod        String
  calcVersion       Int       @default(1)

  createdAt         DateTime @default(now())

  corrections       DailyCloseCorrection[]

  @@unique([asset, date])
}

model DailyCloseCorrection {
  id             String   @id @default(cuid())
  asset          String
  date           DateTime     @db.Date

  oldCloseUsd    Decimal     @db.Decimal(38, 18)
  newCloseUsd    Decimal     @db.Decimal(38, 18)
  oldCalcMethod  String
  newCalcMethod  String
  reason         String

  dailyCloseId   String?
  dailyClose     DailyClose? @relation(fields: [dailyCloseId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())

  @@index([asset, date])
  @@index([dailyCloseId])
}

model CollectionLog {
  id            String   @id @default(cuid())
  sourceId      String
  operation     String
  endpoint      String
  status        String
  httpStatus    Int?
  latencyMs     Int
  errorMessage  String?
  recordsFetched Int?
  collectedAt   DateTime @default(now())

  source        DataSource @relation(fields: [sourceId], references: [id])

  @@index([sourceId, collectedAt])
  @@index([status])
}

model IndicatorSnapshot {
  id          String     @id @default(cuid())
  indicator   String
  scope       String
  asOf        DateTime   @db.Date
  status      String
  value       Decimal?   @db.Decimal(30, 12)
  unit        String
  inputCount  Int
  fromDate    DateTime?  @db.Date
  toDate      DateTime?  @db.Date
  reason      String?
  formulaVersion String
  computedAt  DateTime @default(now())

  @@unique([indicator, scope, asOf, formulaVersion])
  @@index([scope, indicator, asOf])
}

model MarketState {
  id               String    @id @default(cuid())
  asOf             DateTime  @db.Date
  stateVersion     String
  rulesVersion     String
  computeMode      String
  dataQualityScore Decimal   @db.Decimal(6, 5)
  oldestDataDate   DateTime? @db.Date
  payload          Json
  computedAt       DateTime  @default(now())

  @@unique([asOf, stateVersion, rulesVersion, computeMode])
  @@index([stateVersion, asOf])
}

model Token {
  id          String   @id @default(cuid())
  network     String   @default("solana")
  address     String
  name        String?
  symbol      String?
  decimals    Int?
  imageUrl    String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  captures TokenCapture[]
  failures TokenCollectionFailure[]

  @@unique([network, address])
  @@index([symbol])
  @@index([name])
}

model TokenCapture {
  id            String    @id @default(cuid())
  tokenId       String
  priceUsd      Decimal   @db.Decimal(38, 18)
  liquidityUsd  Decimal?  @db.Decimal(38, 2)
  volume24hUsd  Decimal?  @db.Decimal(38, 2)
  txCount24h    Int?
  rawPayload    Json?
  poolsObserved   Int?
  buys24hObserved Int?
  sells24hObserved Int?
  capturedAt    DateTime  @default(now())

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  pools  TokenPoolCapture[]
  holder TokenHolderCapture?

  @@unique([tokenId, capturedAt])
  @@index([tokenId, capturedAt])
}

model TokenCollectionFailure {
  id                String   @id @default(cuid())
  tokenId           String?
  tokenAddress      String?
  operation         String
  endpoint          String
  status            String
  httpStatus        Int?
  retryAfterSeconds Int?
  errorMessage      String?
  attempt           Int      @default(1)
  occurredAt        DateTime @default(now())

  token Token? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([tokenAddress, occurredAt])
  @@index([status, occurredAt])
  @@index([tokenId])
}

model TokenPoolCapture {
  id             String    @id @default(cuid())
  captureId      String
  poolAddress    String
  poolName       String?
  dexId          String?
  reserveInUsd   Decimal?  @db.Decimal(38, 2)
  volume24hUsd   Decimal?  @db.Decimal(38, 2)
  buys24h        Int?
  sells24h       Int?
  buyers24h      Int?
  sellers24h     Int?
  poolCreatedAt  DateTime?
  createdAt      DateTime  @default(now())

  capture TokenCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)

  @@unique([captureId, poolAddress])
  @@index([captureId])
}

model TokenHolderCapture {
  id                String    @id @default(cuid())
  captureId         String    @unique
  holdersCount      Int?
  top10Pct          Decimal?  @db.Decimal(9, 4)
  rank11to20Pct     Decimal?  @db.Decimal(9, 4)
  rank21to40Pct     Decimal?  @db.Decimal(9, 4)
  restPct           Decimal?  @db.Decimal(9, 4)
  sourceLastUpdated DateTime?
  createdAt         DateTime  @default(now())

  capture TokenCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
}
